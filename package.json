{
  "name": "@flotiarenor/dsh-tool-text-editor",
  "version": "1.2.0",
  "description": "Byte-faithful text editing tools (edit_text / write_text) for DeepSeek Harness. They fix three defects of the built-in write/edit (which drop a UTF-8 BOM, flatten CRLF to LF, and match old_string exactly): they preserve the BOM and the file's own CRLF/LF style, fall back to relaxed line-block matching with nearest-candidate hints, back the previous content up, accept grep/lines anchors, and return one stat line instead of echoing the change back into the model context. Pure Node and in-process: no external runtime, no child process, no third-party package, no build step, no imports beyond node: builtins.",
  "type": "module",
  "main": "lib/editor.mjs",
  "exports": {
    ".": "./lib/editor.mjs",
    "./core": "./lib/core.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node tools/check-license.mjs && node tools/selftest.mjs && node tools/measure-context.mjs --cap 2048",
    "check": "node tools/check-license.mjs",
    "check:license": "node tools/check-license.mjs",
    "check:schema": "node tools/gen-schema.mjs",
    "selftest": "node tools/selftest.mjs",
    "measure": "node tools/measure-context.mjs",
    "measure:cap": "node tools/measure-context.mjs --cap 2048",
    "measure:static": "node tools/measure-context.mjs --static --vs-native",
    "probe:mask": "node tools/probe-mask.mjs",
    "repro:mask": "node tools/repro-mask.mjs",
    "audit": "node tools/audit-session.mjs",
    "audit:tools": "node tools/audit-session.mjs --tools",
    "install:preset": "node scripts/install-preset.mjs",
    "prepublishOnly": "node tools/check-license.mjs && node tools/selftest.mjs"
  },
  "files": [
    "lib",
    "preset",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "tool",
    "editor",
    "bom",
    "crlf"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Flotiarenor",
    "url": "https://github.com/Flotiarenor"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 || >=0.1.5-rc.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "homepage": "https://github.com/Flotiarenor/dsh-tool-text-editor#readme",
  "bugs": {
    "url": "https://github.com/Flotiarenor/dsh-tool-text-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Flotiarenor/dsh-tool-text-editor.git"
  }
}
